{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careerpilot-personal",
  "main": "build/cloudflare-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "patchikoru.com/careercopilot*", "zone_name": "patchikoru.com" }],
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "CAREERPILOT_AUTH_MODE": "cloudflare",
    "CF_ACCESS_TEAM_DOMAIN": "yellow-salad-1b22.cloudflareaccess.com",
    "CF_ACCESS_AUD": "acd75430f4670ebae2562b65d0392b71f9d8fc6abff9bacbe0147a7b0ae2c7cf",
    "OWNER_EMAIL": "girish5f9@gmail.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "careerpilot-personal",
    "database_id": "38686ea6-8d97-4c91-9cdb-7cac60e2ae11",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "careerpilot-private-resumes" }]
}
